        var result = (saved ?? (numericOnly ? DefaultAxes : DefaultAttributes)).Where(allowed.Contains).Distinct().ToList();
        return result.Count > 0 || (allowEmpty && saved is not null) ? result : [..(numericOnly ? DefaultAxes : DefaultAttributes)];
    }
    private HashSet<string> TableColumns = DefaultColumns.ToHashSet();
    private IEnumerable<string> ColumnKeys => new[] { "Name", "Caliber" }.Concat(Snapshot.Metrics.Select(m => m.Key));
    private IEnumerable<string> OrderedColumns => ColumnKeys.Where(TableColumns.Contains);
    private IEnumerable<string> DefaultExcludedIds => Snapshot.Items.Where(a => a.DefaultHiddenReason is not null).Select(a => a.TemplateId).Distinct();
    private IEnumerable<string> DefaultExcludedCalibers => Snapshot.Items.Select(a => a.CaliberId).Where(id => DefaultExclusions.IsDefaultCaliber(id, Catalog.ExclusionRules)).Distinct();
    private CaliberChoice[] Calibers = [];
    private IJSObjectReference? _module;
