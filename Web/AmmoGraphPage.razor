    private sealed record CaliberChoice(string Id, string Name, int Count, bool IsPellet);
    private IEnumerable<CaliberChoice> AvailableCalibers => SimulationMode ? SimulatorCalibers : Calibers.Where(c => c.Count > 0 && !ExcludedCalibers.Contains(c.Id) && (ShowPellets || !c.IsPellet));
