    private void ApplyCaliberFilter() { if (AmmoSearch.Normalize(ActiveCaliberSearch).Length == 0) return; if (SimulationMode) SimulatorCaliberId = SearchedCalibers.FirstOrDefault()?.Id ?? ""; else SelectedCalibers = SearchedCalibers.Select(c => c.Id).ToHashSet(); Changed(); }
    private async Task ToggleTheme() { if (_module is null) return; Theme = await _module.InvokeAsync<string>("oppositeTheme"); _save = true; }
    public sealed record Preferences(string Language, string[] Calibers, string XAxis, string YAxis, bool DynamicScale, bool ShowNames, bool ShowPellets, string Search, string CaliberSearch, string SortKey, bool Descending, string? SelectedId, bool? LegacyWholeLoad = null, string[]? Columns = null, string[]? ExcludedCalibers = null, string[]? ExcludedAmmo = null, string[]? IncludedDefaultAmmo = null, string[]? IncludedDefaultCalibers = null, bool? ShowFilters = null, bool? ShowTable = null, bool? ShowDetails = null, string[]? TooltipColumns = null, string[]? DetailColumns = null, string[]? XColumns = null, string[]? YColumns = null, string? Theme = null, Dictionary<string,string?>? CaliberNames = null, bool? SimulationMode = null, SimulatorDraft? Simulator = null);
    private bool IsAllowed(AmmoEntry ammo) => !ExcludedCalibers.Contains(ammo.CaliberId) && !ExcludedAmmo.Contains(ammo.TemplateId);
    private bool HasAmmoFilter => ShowTable && AmmoSearch.Normalize(Search).Length > 0;
    private string EmptyMessage => !AvailableCalibers.Any(c => SelectedCalibers.Contains(c.Id)) ? T["NoCalibers"] : HasAmmoFilter ? T["Empty"] : T["EmptySelection"];
    private AmmoEntry[] VisibleItems => SimulationMode
        ? Snapshot.Items.Where(a => IsAllowed(a) && !a.IsPellet && RawCaliber(a.CaliberId) == SimulatorCaliberId && AmmoSearch.Matches(SimulatorSearch, a.Name, a.Caliber)).ToArray()
        : Snapshot.Items.Where(a => IsAllowed(a) && (ShowPellets || !a.IsPellet) && SelectedCalibers.Contains(a.CaliberId) && (!ShowTable || AmmoSearch.Matches(Search, a.Name, a.Caliber))).ToArray();
    private AmmoEntry? Selected => VisibleItems.FirstOrDefault(a => a.Id == SelectedId);
    private AmmoEntry? Hovered => SelectedId is null || HoveredId == SelectedId ? null : VisibleItems.FirstOrDefault(a => a.Id == HoveredId);

    protected override void OnInitialized()
    {
        Language = Catalog.Snapshot.Language;
        ApplyDefaultExclusions();
        RebuildCalibers();
        var defaults = new[] { "Caliber545x39", "Caliber556x45NATO" }.Where(id => Calibers.Any(c => c.Id == id));
        SelectedCalibers = defaults.ToHashSet();
        if (SelectedCalibers.Count == 0 && Calibers.Length > 0) SelectedCalibers.Add(Calibers[0].Id);
    }

    private void RebuildCalibers() => Calibers = Snapshot.Items.GroupBy(a => a.CaliberId).Select(g => new CaliberChoice(g.Key, g.First().Caliber, g.Count(a => !ExcludedAmmo.Contains(a.TemplateId)), g.First().IsPellet)).OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToArray();
    private void LanguageChanged() { RebuildCalibers(); HoveredId = null; Changed(); }
    private void ApplyDefaultExclusions() { ExcludedAmmo.UnionWith(DefaultExcludedIds.Except(IncludedDefaultAmmo)); ExcludedCalibers.UnionWith(DefaultExcludedCalibers.Except(IncludedDefaultCalibers)); }
    private void ToggleExcludedCaliber(string id)
    {
        if (!ExcludedCalibers.Add(id)) { ExcludedCalibers.Remove(id); if (DefaultExclusions.IsDefaultCaliber(id, Catalog.ExclusionRules)) IncludedDefaultCalibers.Add(id); }
        else IncludedDefaultCalibers.Remove(id);
        Changed();
    }
    private void ToggleExcludedAmmo(string id)
    {
        if (!ExcludedAmmo.Add(id)) { ExcludedAmmo.Remove(id); if (DefaultExcludedIds.Contains(id)) IncludedDefaultAmmo.Add(id); }
        else IncludedDefaultAmmo.Remove(id);
        RebuildCalibers(); Changed();
    }
    private void ShowAllExcluded() { ExcludedCalibers.Clear(); ExcludedAmmo.Clear(); IncludedDefaultAmmo = DefaultExcludedIds.ToHashSet(); IncludedDefaultCalibers = DefaultExcludedCalibers.ToHashSet(); RebuildCalibers(); Changed(); }
    private void ResetExclusions() { ExcludedCalibers.Clear(); ExcludedAmmo.Clear(); IncludedDefaultAmmo.Clear(); IncludedDefaultCalibers.Clear(); ApplyDefaultExclusions(); RebuildCalibers(); Changed(); }
    private void ToggleFilters() { ShowFilters = !ShowFilters; _save = true; }
    private void ToggleTable() { ShowTable = !ShowTable; Changed(); }
    private void ToggleDetails() { ShowDetails = !ShowDetails; _save = true; }
    private void ToggleColumn(string key)
    {
        if (TableColumns.Contains(key) && TableColumns.Count == 1) return;
        if (!TableColumns.Add(key)) TableColumns.Remove(key);
        if (!TableColumns.Contains(SortKey)) { SortKey = OrderedColumns.First(); Descending = false; }
        _save = true;
    }
    private void ResetColumns() { TableColumns = DefaultColumns.ToHashSet(); SortKey = "Name"; Descending = false; _save = true; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "/ammo-graph/preferences.js?v=24.2");
                await _module.InvokeVoidAsync("bindMenus");
                await _module.InvokeVoidAsync("bindPresentation");
                var saved = await _module.InvokeAsync<Preferences?>("load");
                if (saved is not null)
                {
                    if (Catalog.Languages.Any(l => l.Code == saved.Language)) Language = saved.Language;
                    ExcludedCalibers = (saved.ExcludedCalibers ?? []).ToHashSet();
                    ExcludedAmmo = (saved.ExcludedAmmo ?? []).ToHashSet();
                    IncludedDefaultAmmo = (saved.IncludedDefaultAmmo ?? []).ToHashSet();
                    IncludedDefaultCalibers = (saved.IncludedDefaultCalibers ?? []).ToHashSet();
                    ShowFilters = saved.ShowFilters ?? true; ShowTable = saved.ShowTable ?? true; ShowDetails = saved.ShowDetails ?? true;
                    Theme = saved.Theme is "light" or "dark" ? saved.Theme : "system";
                    PersonalCaliberNames = new(StringComparer.OrdinalIgnoreCase);
                    foreach (var kv in saved.CaliberNames ?? new())
                        if (kv.Key.Length is >0 and <=128 && !kv.Key.Contains(':') && (kv.Value is null || (!string.IsNullOrWhiteSpace(kv.Value)&&kv.Value.Length<=128))) PersonalCaliberNames[CaliberNameMap.Normalize(kv.Key.Trim())]=kv.Value;
                    _effectiveNames=null; _personalSnapshot=null;
                    ApplyDefaultExclusions();
                    RebuildCalibers();
                    SelectedCalibers = (saved.Calibers ?? []).Where(id => Calibers.Any(c => c.Id == id)).ToHashSet();
                    if (saved.LegacyWholeLoad.HasValue)
                    {
                        foreach (var id in saved.Calibers ?? [])
                        {
                            var derived = id + (saved.LegacyWholeLoad.Value ? ":shot" : ":pellet");
                            if (Calibers.Any(c => c.Id == derived)) SelectedCalibers.Add(derived);
                        }
                    }
                    if (Snapshot.Metrics.Any(m => m.Key == saved.XAxis)) XAxis = saved.XAxis;
                    if (Snapshot.Metrics.Any(m => m.Key == saved.YAxis)) YAxis = saved.YAxis;
                    TooltipColumns = RestoreAttributes(saved.TooltipColumns, true, true); DetailColumns = RestoreAttributes(saved.DetailColumns, true, true);
                    XColumns = RestoreAttributes((saved.XColumns ?? DefaultAxes).Concat(saved.YColumns ?? DefaultAxes).Distinct().ToArray(), true, true); YColumns = XColumns;
                    if (saved.XColumns is null && !XColumns.Contains(XAxis)) XColumns.Add(XAxis);
                    if (saved.YColumns is null && !YColumns.Contains(YAxis)) YColumns.Add(YAxis);
                    if (XColumns.Count > 0 && !XColumns.Contains(XAxis)) XAxis = XColumns[0];
                    if (YColumns.Count > 0 && !YColumns.Contains(YAxis)) YAxis = YColumns[0];
                    DynamicScale = saved.DynamicScale; ShowNames = saved.ShowNames; ShowPellets = saved.ShowPellets;
                    Search = (saved.Search ?? "")[..Math.Min(128, (saved.Search ?? "").Length)];
                    CaliberSearch = (saved.CaliberSearch ?? "")[..Math.Min(128, (saved.CaliberSearch ?? "").Length)];
                    if (saved.SortKey is "Name" or "Caliber" || Snapshot.Metrics.Any(m => m.Key == saved.SortKey)) SortKey = saved.SortKey;
                    Descending = saved.Descending; SelectedId = saved.SelectedId;
                    var savedColumns = (saved.Columns ?? DefaultColumns).Where(ColumnKeys.Contains).ToHashSet();
                    TableColumns = savedColumns.Count > 0 ? savedColumns : DefaultColumns.ToHashSet();
                    if (!TableColumns.Contains(SortKey)) { SortKey = OrderedColumns.First(); Descending = false; }
                    SimulationMode = saved.SimulationMode ?? false;
                    if (saved.Simulator is { } simulator && simulator.CaliberId is { Length: >0 and <=128 }
                        && simulator.Magazine is { Capacity: >=1 and <=100, Middle: { Length: <=100 } } && simulator.Slots is { Count: <=64 }
                        && double.IsFinite(simulator.PelletHitPercent) && simulator.PelletHitPercent is >=0 and <=100)
                    { SimulatorCaliberId = simulator.CaliberId; SimulatorWorkspace.Update(simulator); }
                    EnsureSimulatorCaliber();
                    FilterChanged();
                }
                _preferencesLoaded = true;
                _save = true;
                StateHasChanged();
            }
            if (_save && _module is not null)
            {
                _save = false;
                await _module.InvokeAsync<bool>("save", new Preferences(Language, SelectedCalibers.Order().ToArray(), XAxis, YAxis, DynamicScale, ShowNames, ShowPellets, Search, CaliberSearch, SortKey, Descending, SelectedId,
                    Columns: TableColumns.Order().ToArray(), ExcludedCalibers: ExcludedCalibers.Order().ToArray(), ExcludedAmmo: ExcludedAmmo.Order().ToArray(), IncludedDefaultAmmo: IncludedDefaultAmmo.Order().ToArray(), IncludedDefaultCalibers: IncludedDefaultCalibers.Order().ToArray(), ShowFilters: ShowFilters, ShowTable: ShowTable, ShowDetails: ShowDetails, TooltipColumns: TooltipColumns.ToArray(), DetailColumns: DetailColumns.ToArray(), XColumns: XColumns.ToArray(), YColumns: YColumns.ToArray(), Theme: Theme, CaliberNames: PersonalCaliberNames, SimulationMode: SimulationMode, Simulator: string.IsNullOrEmpty(SimulatorCaliberId) ? null : SimulatorWorkspace.Get(SimulatorCaliberId)));
            }
            if (_module is not null) await _module.InvokeVoidAsync("syncChart");
            if (_module is not null) await _module.InvokeVoidAsync("syncFans");
            if (_module is not null) await _module.InvokeVoidAsync("syncPresentation");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* Preferences are optional; the graph remains usable without browser storage. */ }
    }
    private void Changed() { if (SimulationMode) EnsureSimulatorCaliber(); _save = true; FilterChanged(); }
    private void FilterChanged() { if (SimulationMode) return; var visible = VisibleItems; if (SelectedId is not null && !visible.Any(a => a.Id == SelectedId)) SelectedId = null; if (HoveredId is not null && !visible.Any(a => a.Id == HoveredId)) HoveredId = null; }
    private void Toggle(string id) { if (SimulationMode) { SimulatorCaliberId = id; Changed(); return; } if (!SelectedCalibers.Add(id)) SelectedCalibers.Remove(id); Changed(); }
    private void LegendClick(MouseEventArgs e, string id) { if (e.Detail <= 1) Toggle(id); }
    private void SelectOnly(string id) { if (SimulationMode) SimulatorCaliberId = id; else SelectedCalibers = [id]; Changed(); }
    private void SelectAll() { SelectedCalibers.UnionWith(AvailableCalibers.Select(c => c.Id)); Changed(); }
    private void SelectNone() { SelectedCalibers.Clear(); Changed(); }
    private void SwapAxes() { (XAxis, YAxis) = (YAxis, XAxis); if (!XColumns.Contains(XAxis)) XColumns.Add(XAxis); if (!YColumns.Contains(YAxis)) YColumns.Add(YAxis); Changed(); }
    private void Select(string id) { if (SimulationMode) return; SelectedId = id; HoveredId = null; _save = true; }
    private void SelectGroup(AmmoEntry[] members) => Select(members[(Array.FindIndex(members, a => a.Id == SelectedId) + 1) % members.Length].Id);
    private void Hover(string id) => HoveredId = id;
    private void HoverGroup(AmmoEntry[] members) { TooltipItems = members; HoveredId = (members.FirstOrDefault(a => a.Id != SelectedId) ?? members[0]).Id; }
    private void ClearHover() => HoveredId = null;
    private void PointKey(KeyboardEventArgs e, AmmoEntry[] members) { if (e.Key is "Enter" or " ") SelectGroup(members); }
    private void Sort(string key) { Descending = SortKey == key && !Descending; SortKey = key; _save = true; }
    private IEnumerable<AmmoEntry> SortItems(IEnumerable<AmmoEntry> items) => SortKey is "Name" or "Caliber"
        ? Descending ? items.OrderByDescending(a => SortKey == "Name" ? a.Name : a.Caliber, StringComparer.OrdinalIgnoreCase) : items.OrderBy(a => SortKey == "Name" ? a.Name : a.Caliber, StringComparer.OrdinalIgnoreCase)
        : ShotsToKillEvaluation.IsMetric(SortKey) ? (Descending ? items.OrderByDescending(a => a, ShotsToKillEvaluation.Comparer(SortKey)) : items.OrderBy(a => a, ShotsToKillEvaluation.Comparer(SortKey)))
        : Descending ? items.OrderByDescending(a => Value(a, SortKey)) : items.OrderBy(a => Value(a, SortKey));
    private AmmoMetric Metric(string key) => Snapshot.Metrics.First(m => m.Key == key);
    private string AxisLabel(string key) => Metric(key).DisplayLabel;
    private double? Value(AmmoEntry ammo, string key) => SnapshotBuilder.Value(ammo, key);
    private string Display(AmmoEntry ammo, string key) => ShotsToKillEvaluation.IsMetric(key) ? ShotsToKillEvaluation.Display(ammo, key, T.Culture) : Value(ammo, key) is { } value ? Format(value) + (Metric(key).Unit.Length == 0 ? "" : " " + Metric(key).Unit) : "—";
    private string Format(double value) => value.ToString(value != 0 && Math.Abs(value) < 0.001 ? "G3" : "0.###", T.Culture);
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private int Index(string id) => Array.IndexOf(Calibers.Select(c => c.Id).Order(StringComparer.Ordinal).ToArray(), id);
    private int Shape(string id) => Math.Max(0, Index(id)) % 10;
    private string Color(string id) => Colors[Math.Max(0, Index(id)) % Colors.Length];
    private string ShortName(AmmoEntry ammo) => ammo.Name.Length > 28 ? ammo.Name[..26] + "…" : ammo.Name;
    private string PointTitle(AmmoEntry[] members) => string.Join("\n", members.Select(a => $"{a.Name} · {a.Caliber}\n{Metric(XAxis).DisplayLabel}: {Display(a, XAxis)} · {Metric(YAxis).DisplayLabel}: {Display(a, YAxis)}"));
    private ChartAxis Range(IEnumerable<AmmoEntry> items, string key) => ChartAxis.Create(items.Select(a => Value(a, key)).Where(v => v.HasValue).Select(v => v!.Value));
    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { try { await _module.InvokeVoidAsync("destroyFans"); await _module.InvokeVoidAsync("destroyChart"); await _module.InvokeVoidAsync("unbindMenus"); await _module.InvokeVoidAsync("unbindPresentation"); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
