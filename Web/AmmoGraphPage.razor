@page "/AmmoGraph"
@layout GraphLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AmmoCatalog Catalog
@inject IJSRuntime JS

<PageTitle>Ammo Graph · SPT</PageTitle>
<div class="ag-app" lang="@Language" dir="@(T.RightToLeft ? "rtl" : "ltr")" data-theme="@Theme" data-ready="@(_preferencesLoaded ? "true" : "false")">
    <header class="ag-header">
        <a href="/AmmoGraph" class="ag-brand"><span class="ag-brand-mark">A<span>G</span></span><span>SPT <strong>AMMO GRAPH</strong><small>@T["Subtitle"]</small></span></a>
        <div class="ag-header-actions">
            <label class="ag-language"><span>@T["Language"]</span><select id="ag-language" @bind="Language" @bind:after="LanguageChanged">@foreach (var language in Catalog.Languages) { <option value="@language.Code">@language.Name</option> }</select></label>
            <ExclusionEditor Items="Snapshot.Items" ExcludedCalibers="ExcludedCalibers" ExcludedAmmo="ExcludedAmmo" Text="T" OnCaliberToggle="ToggleExcludedCaliber" OnAmmoToggle="ToggleExcludedAmmo" OnShowAll="ShowAllExcluded" OnReset="ResetExclusions" ShowFilters="ShowFilters" ShowTable="ShowTable" ShowDetails="ShowDetails" OnToggleFilters="ToggleFilters" OnToggleTable="ToggleTable" OnToggleDetails="ToggleDetails">
                <details class="ag-settings-section ag-attribute-settings" name="ag-settings" data-settings-section="attributes"><summary>@T["Attributes"]</summary>
                    <AttributePicker Scope="tooltip" Title="@T["Tooltip"]" Selected="TooltipColumns" Options="MetricOptions" Defaults="DefaultAxes" Text="T" OnChange="v => SetAttributes(0, v)" />
                    <AttributePicker Scope="details" Title="@T["Selected"]" Selected="DetailColumns" Options="MetricOptions" Defaults="DefaultAxes" Text="T" OnChange="v => SetAttributes(1, v)" />
                    <AttributePicker Scope="axes" Title="@(T["XAxis"] + " / " + T["YAxis"])" Selected="XColumns" Options="MetricOptions" Defaults="DefaultAxes" Text="T" OnChange="v => SetAttributes(2, v)" />
                </details>
                <CaliberNameEditor Items="Snapshot.Items" Names="EffectiveCaliberNames" Text="T" OnSave="SavePersonalName" OnReset="ResetPersonalNames" />
            </ExclusionEditor>
            <button type="button" class="ag-theme-toggle ag-view-toggle" data-view-toggle aria-label="@(SimulationMode ? T["SimOpenGraph"] : T["SimOpenSimulator"])" title="@(SimulationMode ? T["SimOpenGraph"] : T["SimOpenSimulator"])" aria-pressed="@SimulationMode.ToString().ToLowerInvariant()" @onclick="ToggleView"><MenuIcon Kind="@(SimulationMode ? "graph" : "cartridge")" /></button>
            <ThemePicker Text="T" OnToggle="ToggleTheme" />
            <a class="ag-server-link" href="/">SPT ↗</a>
        </div>
    </header>
    @if (!Catalog.Ready)
    {
        <main class="ag-loading" role="status">@T["Loading"]</main>
    }
    else
    {
        var visible = VisibleItems;
        var reference = SimulationMode ? null : Selected;
        var plotted = XColumns.Count == 0 ? Array.Empty<AmmoEntry>() : visible.Where(a => Value(a, XAxis).HasValue && Value(a, YAxis).HasValue).ToArray();
        var scaleItems = DynamicScale ? plotted : Snapshot.Items.Where(a => IsAllowed(a) && (ShowPellets || !a.IsPellet) && Value(a, XAxis).HasValue && Value(a, YAxis).HasValue).ToArray();
        var xr = Range(scaleItems, XAxis);
        var yr = Range(scaleItems, YAxis);
        <div class="ag-workspace @(!ShowFilters && !SimulationMode ? "ag-no-sidebar" : "")">
            @if (ShowFilters || SimulationMode)
            {
            <aside @key="SimulationMode" class="ag-sidebar" aria-label="@T["Calibers"]">
                <div class="ag-section-title"><h2>@T["Calibers"]</h2><span>@AvailableCalibers.Count(c => IsCaliberActive(c.Id)) / @AvailableCalibers.Count()</span></div>
                <input class="ag-input" maxlength="128" aria-label="@T["CaliberSearch"]" placeholder="@T["CaliberSearch"]" @bind="ActiveCaliberSearch" @bind:event="oninput" @bind:after="Changed" />
                @if (!SimulationMode) { <div class="ag-bulk"><button @onclick="SelectAll">@T["All"]</button><button @onclick="SelectNone">@T["None"]</button></div> }
                <button type="button" class="ag-apply-filter" disabled="@(AmmoSearch.Normalize(ActiveCaliberSearch).Length == 0)" @onclick="ApplyCaliberFilter">@T["ApplyFilter"]</button>
                <div class="ag-calibers">
                    @foreach (var cal in SearchedCalibers)
                    {
                        <label @key="cal.Id" class="ag-caliber @(IsCaliberActive(cal.Id) ? "is-active" : "")" data-caliber="@cal.Id" style="--caliber-color:@Color(cal.Id)" @ondblclick="() => SelectOnly(cal.Id)" @ondblclick:preventDefault="true">
                            <input type="@(SimulationMode ? "radio" : "checkbox")" name="ag-caliber" checked="@IsCaliberActive(cal.Id)" @onchange="() => Toggle(cal.Id)" />
                            <CaliberSymbol Shape="@Shape(cal.Id)" /><span dir="ltr">@cal.Name</span><small>@cal.Count</small>
                        </label>
                    }
                </div>
            </aside>
            }
            <main class="ag-main">
                @if (SimulationMode)
                {
                    <BallisticsSimulator @ref="_simulator" Catalog="Catalog.Simulation" Workspace="SimulatorWorkspace" CaliberId="@SimulatorCaliberId" Ammo="SimulatorAmmo" Text="T" Language="@Language" OnChanged="SimulatorChanged" OnAmmoHover="SimulatorHover" />
                }
                else
                {
                <section class="ag-toolbar" aria-label="@T["Chart"]">
                    <div class="ag-axis-controls">
                        <label>@T["XAxis"]<select id="ag-x" disabled="@(XColumns.Count == 0)" @bind="XAxis" @bind:after="Changed">@foreach (var key in XColumns) { <option value="@key">@Metric(key).DisplayLabel</option> }</select></label>
                        <button class="ag-swap" disabled="@(XColumns.Count == 0)" aria-label="@T["XAxis"] ↔ @T["YAxis"]" @onclick="SwapAxes">⇄</button>
                        <label>@T["YAxis"]<select id="ag-y" disabled="@(YColumns.Count == 0)" @bind="YAxis" @bind:after="Changed">@foreach (var key in YColumns) { <option value="@key">@Metric(key).DisplayLabel</option> }</select></label>
                    </div>
                    <div class="ag-chart-options"><label><input type="checkbox" @bind="DynamicScale" @bind:after="Changed" /> @T["AutoScale"]</label><label><input type="checkbox" @bind="ShowNames" @bind:after="Changed" /> @T["ShowNames"]</label></div>
                </section>
                <div class="ag-analysis @(!ShowDetails ? "ag-no-details" : "")">
                    <section class="ag-chart-panel" aria-label="@T["Chart"]">
                        <div class="ag-chart-heading"><h1>@Metric(YAxis).DisplayLabel <span>×</span> @Metric(XAxis).DisplayLabel</h1><div class="ag-navigation-controls"><span class="ag-count">@plotted.Length @T["Rows"]</span><button type="button" data-nav="in" aria-label="@T["ZoomIn"]" title="@T["ZoomIn"]">+</button><button type="button" data-nav="out" aria-label="@T["ZoomOut"]" title="@T["ZoomOut"]">−</button><button type="button" data-nav="reset" aria-label="@T["ResetView"]" title="@T["ResetView"]">↺</button></div></div>
                        <div class="ag-chart-wrap">
                            <svg class="ag-chart" viewBox="0 0 960 550" role="img" tabindex="0" aria-label="@($"{T["Subtitle"]}: {Metric(XAxis).DisplayLabel} / {Metric(YAxis).DisplayLabel}, {plotted.Length}")" data-x-key="@XAxis" data-y-key="@YAxis" data-language="@Language" data-x-min="@xr.Min.ToString("R", CultureInfo.InvariantCulture)" data-x-max="@xr.Max.ToString("R", CultureInfo.InvariantCulture)" data-y-min="@yr.Min.ToString("R", CultureInfo.InvariantCulture)" data-y-max="@yr.Max.ToString("R", CultureInfo.InvariantCulture)">
                                <defs><clipPath id="ag-plot-clip"><rect x="84" y="42" width="832" height="428" /></clipPath></defs>
                                <g class="ag-static-axes">
                                @foreach (var tick in xr.Ticks)
                                {
                                    var x = 84 + (tick - xr.Min) / (xr.Max - xr.Min) * 832;
                                    <g class="ag-grid"><line x1="@F(x)" y1="42" x2="@F(x)" y2="470" /></g>
                                    <g class="ag-tick"><text x="@F(x)" y="496" text-anchor="middle">@Format(tick)</text></g>
                                }
                                @foreach (var tick in yr.Ticks)
                                {
                                    var y = 470 - (tick - yr.Min) / (yr.Max - yr.Min) * 428;
                                    <g class="ag-grid"><line x1="84" y1="@F(y)" x2="916" y2="@F(y)" /></g>
                                    <g class="ag-tick"><text x="70" y="@F(y + 4)" text-anchor="end">@Format(tick)</text></g>
                                }
                                </g>
                                <g class="ag-navigation-axes" aria-hidden="true"></g>
                                <g class="ag-axis-label"><text x="500" y="533" text-anchor="middle">@AxisLabel(XAxis)</text><text x="0" y="0" transform="translate(21 255) rotate(-90)" text-anchor="middle">@AxisLabel(YAxis)</text></g>
                                <g class="ag-point-layer" clip-path="url(#ag-plot-clip)">
                                @foreach (var group in plotted.GroupBy(a => (X: Value(a, XAxis)!.Value, Y: Value(a, YAxis)!.Value)).OrderBy(g => g.Count()))
                                {
                                    var members = group.ToArray();
                                    var ammo = members.FirstOrDefault(a => a.Id == SelectedId) ?? members[0];
                                    var x = 84 + (group.Key.X - xr.Min) / (xr.Max - xr.Min) * 832;
                                    var y = 470 - (group.Key.Y - yr.Min) / (yr.Max - yr.Min) * 428;
                                    var selected = members.Any(a => a.Id == SelectedId);
                                    <g class="ag-point @(selected ? "is-selected" : "")" data-id="@string.Join(",", members.Select(a => a.Id))" data-x="@group.Key.X.ToString("R", CultureInfo.InvariantCulture)" data-y="@group.Key.Y.ToString("R", CultureInfo.InvariantCulture)" data-base-x="@F(x)" data-base-y="@F(y)" role="button" tabindex="0" aria-label="@PointTitle(members)" style="color:@Color(ammo.CaliberId)" @onclick="() => SelectGroup(members)" @onkeydown="e => PointKey(e, members)" @onmouseenter="() => HoverGroup(members)" @onmouseleave="ClearHover" @onfocus="() => HoverGroup(members)" @onblur="ClearHover">
                                        <circle cx="@F(x)" cy="@F(y)" r="13" class="ag-hit-area" />
                                        @if (selected) { <circle cx="@F(x)" cy="@F(y)" r="11" class="ag-selection-ring" /> }
                                        <g transform="@($"translate({F(x)} {F(y)})")"><CaliberMarker Shape="@Shape(ammo.CaliberId)" /></g>
                                        @if (ShowNames || selected) { <g><text class="ag-point-name" x="@F(Math.Min(x + 12, 780))" y="@F(Math.Max(y - 12, 28))">@ShortName(ammo)</text></g> }
                                        @if (members.Length > 1) { <g><text class="ag-overlap" x="@F(x + 8)" y="@F(y + 15)">+@(members.Length - 1)</text></g> }
                                    </g>
                                }
                                </g>
                                <g class="ag-fan-layer">
                                @foreach (var group in plotted.GroupBy(a => (X: Value(a, XAxis)!.Value, Y: Value(a, YAxis)!.Value)).Where(g => g.Count() > 1))
                                {
                                    var members = group.ToArray();
                                    <g class="ag-fan" data-group="@string.Join(",", members.Select(a => a.Id))">
                                        <circle class="ag-fan-hit" r="0" />
                                        @foreach (var member in members) { <line class="ag-fan-line" data-member="@member.Id" style="color:@Color(member.CaliberId)" /> }
                                        <circle class="ag-fan-origin" r="3.5" />
                                        @foreach (var member in members)
                                        {
                                            <g @key="member.Id" class="ag-fan-point @(SelectedId == member.Id ? "is-selected" : "")" data-id="@member.Id" role="button" tabindex="-1" aria-label="@PointTitle([member])" style="color:@Color(member.CaliberId)" @onclick="() => Select(member.Id)" @onclick:stopPropagation="true" @onkeydown="e => PointKey(e, [member])" @onmouseenter="() => HoverGroup([member])" @onmouseleave="ClearHover" @onfocus="() => HoverGroup([member])" @onblur="ClearHover">
                                                <circle class="ag-hit-area" r="13" />
                                                @if (SelectedId == member.Id) { <circle class="ag-selection-ring" r="11" /> }
                                                <CaliberMarker Shape="@Shape(member.CaliberId)" />
                                                @if (ShowNames) { <g><text class="ag-point-name ag-fan-name" x="12" y="-12">@ShortName(member)</text></g> }
                                            </g>
                                        }
                                    </g>
                                }
                                </g>
                            </svg>
                            @if (plotted.Length == 0) { <div class="ag-chart-empty" role="status">@(XColumns.Count == 0 ? T["NoAxisAttributes"] : visible.Length == 0 ? EmptyMessage : T["Missing"])</div> }
                        </div>
                        <p class="ag-navigation-hint">@T["NavigationHint"]</p>
                        <div class="ag-legend-bulk"><button type="button" data-legend-all @onclick="SelectAll">@T["All"]</button><button type="button" data-legend-none @onclick="SelectNone">@T["None"]</button><label class="ag-pellet-option"><input id="ag-pellets" type="checkbox" @bind="ShowPellets" @bind:after="Changed" />@T["ShowPellets"]</label></div>
                        <div class="ag-legend">@foreach (var cal in AvailableCalibers) { <button @key="cal.Id" class="@(IsCaliberActive(cal.Id) ? "is-active" : "")" data-caliber="@cal.Id" aria-pressed="@(IsCaliberActive(cal.Id) ? "true" : "false")" style="--caliber-color:@Color(cal.Id)" @onclick="e => LegendClick(e, cal.Id)" @ondblclick="() => SelectOnly(cal.Id)" @ondblclick:preventDefault="true"><CaliberSymbol Shape="@Shape(cal.Id)" /><span dir="ltr">@cal.Name</span></button> }</div>
                    </section>
                    @if (ShowDetails)
                    {
                    <aside class="ag-details" aria-label="@T["Selected"]">
                        <h2>@T["Selected"]</h2>
                        @if (Selected is { } detail)
                        {
                            <div class="ag-detail-identity"><span data-detail="Icon" style="--caliber-color:@Color(detail.CaliberId)"><CaliberSymbol Shape="@Shape(detail.CaliberId)" /></span><span class="ag-detail-caliber" data-detail="Caliber" dir="ltr">@detail.Caliber</span></div>
                            <h3 data-detail="Name">@detail.Name</h3>
                            @if (Hovered is { } comparison) { <div class="ag-comparison-heading" aria-live="polite"><span>@T["Compare"]</span><strong>@comparison.Name</strong></div> }
                            else { <div class="ag-comparison-heading ag-comparison-placeholder" aria-hidden="true"></div> }
                            @foreach (var key in DetailColumns)
                            {
                                <dl class="ag-primary-values" data-detail="@key"><div><dt>@Metric(key).DisplayLabel</dt><dd><ComparedValue Baseline="detail" Candidate="Hovered" Metric="Metric(key)" Text="T" /></dd></div></dl>
                            }
                            @if (ShowAllValues)
                            {
                                <dl class="ag-secondary-values ag-extra-values">@foreach (var metric in Snapshot.Metrics.Where(m => !DetailColumns.Contains(m.Key))) { <div><dt>@metric.DisplayLabel</dt><dd><ComparedValue Baseline="detail" Candidate="Hovered" Metric="metric" Text="T" /></dd></div> }</dl>
                            }
                            @if (Snapshot.Metrics.Any(m => !DetailColumns.Contains(m.Key)))
                            {
                                <button type="button" class="ag-all-values" aria-expanded="@ShowAllValues.ToString().ToLowerInvariant()" @onclick="() => ShowAllValues = !ShowAllValues"><span aria-hidden="true">@(ShowAllValues ? "▴" : "▾")</span> @T["AllValues"]</button>
                            }
                        }
                        else { <p class="ag-select-hint">@T["SelectHint"]</p> }
                    </aside>
                    }
                </div>
                }
                @if (ShowTable || SimulationMode)
                {
                <section class="ag-table-panel" aria-label="@T["Visible"]">
                    <div class="ag-table-heading"><div><h2>@T["Visible"]</h2><span class="ag-count">@visible.Length @T["Rows"]</span></div><div class="ag-table-tools"><input class="ag-input" maxlength="128" aria-label="@T["AmmoSearch"]" placeholder="@T["AmmoSearch"]" @bind="ActiveSearch" @bind:event="oninput" @bind:after="Changed" /><ColumnPicker Metrics="Snapshot.Metrics" Selected="TableColumns" Text="T" OnToggle="ToggleColumn" OnReset="ResetColumns" /></div></div>
                    <div class="ag-table-scroll"><table class="ag-comparison-table"><thead><tr>
                        @foreach (var key in OrderedColumns)
                        { <th data-column="@key" class="@(key is "Name" or "Caliber" ? "" : "ag-numeric")" aria-sort="@(SortKey == key ? Descending ? "descending" : "ascending" : "none")"><button @onclick="() => Sort(key)">@(key == "Name" ? T["Ammo"] : key == "Caliber" ? T["Calibers"] : Metric(key).DisplayLabel) <span>@(SortKey == key ? Descending ? "↓" : "↑" : "↕")</span></button></th> }
                        @if (SimulationMode) { <th>@T["SimMagazine"]</th> }
                    </tr></thead><tbody>
                        @foreach (var ammo in SortItems(visible))
                        {
                            <tr data-ammo="@ammo.Id" class="@(SelectedId == ammo.Id ? "is-selected" : "")" @onclick="() => Select(ammo.Id)" @onmouseenter="() => Hover(ammo.Id)" @onmouseleave="ClearHover">
                                @foreach (var key in OrderedColumns)
                                {
                                    @if (key == "Name") { <td data-column="Name"><button class="ag-ammo-name" @onclick="() => Select(ammo.Id)" @onfocus="() => Hover(ammo.Id)" @onblur="ClearHover">@ammo.Name</button></td> }
                                    else if (key == "Caliber") { <td data-column="Caliber" class="ag-caliber-cell"><CaliberSymbol Shape="@Shape(ammo.CaliberId)" Style="@($"--caliber-color:{Color(ammo.CaliberId)}")" /> <span dir="ltr">@ammo.Caliber</span></td> }
                                    else { <td data-column="@key" class="ag-numeric" data-value="@(Value(ammo, key)?.ToString(CultureInfo.InvariantCulture))"><TableValue Item="ammo" Reference="reference" Metric="Metric(key)" Text="T" /></td> }
                                }
                                @if (SimulationMode)
                                {
                                    <td class="ag-sim-table-actions" @onclick:stopPropagation="true"><button type="button" aria-label="@(T["SimStart"] + ": " + ammo.Name)" @onclick='() => AddToMagazine(ammo.TemplateId, "start")'>@T["SimStart"]</button><button type="button" aria-label="@(T["SimMiddle"] + ": " + ammo.Name)" @onclick='() => AddToMagazine(ammo.TemplateId, "middle")'>@T["SimMiddle"]</button><button type="button" aria-label="@(T["SimEnd"] + ": " + ammo.Name)" @onclick='() => AddToMagazine(ammo.TemplateId, "end")'>@T["SimEnd"]</button></td>
                                }
                            </tr>
                        }
                    </tbody></table></div>
                    @if (visible.Length == 0) { <p class="ag-table-empty" role="status">@EmptyMessage</p> }
                </section>
                }
            </main>
        </div>
        <div class="ag-tooltip" id="ag-tooltip" role="tooltip" tabindex="0" data-group="@string.Join(",", TooltipItems.Select(a => a.Id))">
            <div class="ag-tooltip-scroll">
                @foreach (var ammo in TooltipItems)
                {
                    <article class="ag-tooltip-entry" data-tooltip-ammo="@ammo.Id" style="--caliber-color:@Color(ammo.CaliberId)">
                        <div class="ag-tooltip-identity"><span data-tooltip-column="Icon" data-tooltip-value="Icon"><CaliberSymbol Shape="@Shape(ammo.CaliberId)" /></span><span class="ag-tooltip-caliber" data-tooltip-column="Caliber" data-tooltip-value="Caliber" dir="ltr">@ammo.Caliber</span></div>
                        <div class="ag-tooltip-name" data-tooltip-column="Name" data-tooltip-value="Name">@ammo.Name</div>
                        <dl>
                            @foreach (var key in TooltipColumns)
                            {
                                <div data-tooltip-column="@key" class="ag-tooltip-field ag-tooltip-metric">
                                    <dt>@AttributeLabel(key)</dt>
                                    <dd data-tooltip-value="@key">@Display(ammo, key)</dd>
                                </div>
                            }
                        </dl>
                    </article>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool SimulationMode;
    private string SimulatorCaliberId = "", SimulatorSearch = "", SimulatorCaliberSearch = "";
    private readonly SimulatorWorkspace SimulatorWorkspace = new();
    private BallisticsSimulator? _simulator;
    private string ActiveSearch { get => SimulationMode ? SimulatorSearch : Search; set { if (SimulationMode) SimulatorSearch = value; else Search = value; } }
    private string ActiveCaliberSearch { get => SimulationMode ? SimulatorCaliberSearch : CaliberSearch; set { if (SimulationMode) SimulatorCaliberSearch = value; else CaliberSearch = value; } }
    private static string RawCaliber(string id) => id.Split(':')[0];
    private AmmoEntry[] SimulatorAmmo => Snapshot.Items.Where(a => !a.IsPellet && IsAllowed(a) && RawCaliber(a.CaliberId) == SimulatorCaliberId).ToArray();
    private IEnumerable<CaliberChoice> SimulatorCalibers => Snapshot.Items.Where(a => !a.IsPellet && IsAllowed(a)).GroupBy(a => RawCaliber(a.CaliberId))
        .Select(g => new CaliberChoice(g.Key, (g.FirstOrDefault(a => a.CaliberId == g.Key)?.Caliber ?? g.First().Caliber).Split(" · ", StringSplitOptions.None)[0], g.Count(), false))
        .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase);
    private bool IsCaliberActive(string id) => SimulationMode ? SimulatorCaliberId == id : SelectedCalibers.Contains(id);
    private void EnsureSimulatorCaliber()
    {
        if (!SimulatorCalibers.Any(c => c.Id == SimulatorCaliberId))
            SimulatorCaliberId = SimulatorCalibers.FirstOrDefault(c => SelectedCalibers.Any(id => RawCaliber(id) == c.Id))?.Id
                ?? SimulatorCalibers.FirstOrDefault()?.Id ?? "";
    }
    private void ToggleView() { SimulationMode = !SimulationMode; EnsureSimulatorCaliber(); HoveredId = null; TooltipItems = []; _save = true; }
    private void SimulatorHover(string id) { var ammo = SimulatorAmmo.FirstOrDefault(a => a.TemplateId == id); if (ammo is not null) HoverGroup([ammo]); }
    private void SimulatorChanged() => _save = true;
    private Task AddToMagazine(string id, string section) => _simulator?.AddAmmo(id, section) ?? Task.CompletedTask;
    private string Language = "en";
    private string Theme = "system";
    private bool ShowAllValues;
    private Dictionary<string,string?> PersonalCaliberNames = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyDictionary<string,string>? _effectiveNames;
    private IReadOnlyDictionary<string,string> EffectiveCaliberNames => _effectiveNames ??= CaliberNameMap.WithOverrides(Catalog.CaliberNames,PersonalCaliberNames);
    private AmmoSnapshot? _personalSnapshot, _snapshotBase;
    private AmmoSnapshot Snapshot
    {
        get { var source=Catalog.GetBaseSnapshot(Language); if (_personalSnapshot is null || !ReferenceEquals(source,_snapshotBase)) { _snapshotBase=source; _personalSnapshot=SnapshotBuilder.RenameCalibers(source,EffectiveCaliberNames); } return _personalSnapshot; }
    }
    private void PersonalNamesChanged() { _effectiveNames=null; _personalSnapshot=null; RebuildCalibers(); HoveredId=null; TooltipItems=[]; Changed(); }
    private void SavePersonalName(KeyValuePair<string,string?> change)
    {
        if (!Snapshot.Items.Any(a=>a.CaliberId.Split(':')[0]==change.Key) || (change.Value is not null && (string.IsNullOrWhiteSpace(change.Value) || change.Value.Trim().Length>128))) throw new ArgumentException("Invalid caliber name.");
        PersonalCaliberNames[CaliberNameMap.Normalize(change.Key)] = change.Value?.Trim().Replace('×','x'); PersonalNamesChanged();
    }
    private void ResetPersonalNames() { PersonalCaliberNames.Clear(); PersonalNamesChanged(); }
    private UiText T => new(Language);
    private string XAxis = "Damage", YAxis = "PenetrationPower", Search = "", CaliberSearch = "", SortKey = "Name";
    private bool DynamicScale = true, ShowNames, ShowPellets, Descending, _save, _preferencesLoaded;
    private bool ShowFilters = true, ShowTable = true, ShowDetails = true;
    private string? SelectedId, HoveredId;
    private HashSet<string> SelectedCalibers = [];
    private HashSet<string> ExcludedCalibers = [], ExcludedAmmo = [], IncludedDefaultAmmo = [];
    private HashSet<string> IncludedDefaultCalibers = [];
    private static readonly string[] DefaultColumns = ["Name", "Caliber", "Damage", "PenetrationPower", "InitialSpeed"];
    private static readonly string[] DefaultAttributes = ["Icon", "Caliber", "Name", "Damage", "PenetrationPower", "InitialSpeed"];
    private static readonly string[] DefaultAxes = ["Damage", "PenetrationPower", "InitialSpeed"];
    private List<string> TooltipColumns = [..DefaultAxes], DetailColumns = [..DefaultAxes], XColumns = [..DefaultAxes], YColumns = [..DefaultAxes];
    private AmmoEntry[] TooltipItems = [];
    private IReadOnlyList<(string Key, string Label)> MetricOptions => Snapshot.Metrics.Select(m => (m.Key, m.DisplayLabel)).ToArray();
    private IReadOnlyList<(string Key, string Label)> AttributeOptions => new[] { ("Icon", T["Icon"]), ("Caliber", T["Calibers"]), ("Name", T["Ammo"]) }.Concat(MetricOptions).ToArray();
    private string AttributeLabel(string key) => key switch { "Icon" => T["Icon"], "Caliber" => T["Calibers"], "Name" => T["Ammo"], _ => Metric(key).DisplayLabel };
    private void SetAttributes(int scope, List<string> values)
    {
        switch (scope)
        {
            case 0: TooltipColumns = values; break;
            case 1: DetailColumns = values; break;
            case 2: XColumns = values; YColumns = values; if (values.Count > 0) { if (!values.Contains(XAxis)) XAxis = values[0]; if (!values.Contains(YAxis)) YAxis = values[0]; } break;
        }
        Changed();
    }
    private List<string> RestoreAttributes(string[]? saved, bool numericOnly = false, bool allowEmpty = false)
    {
