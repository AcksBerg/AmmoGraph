<g class="ag-marker" data-shape="@Shape" fill="@(Shape >= 5 ? "none" : "currentColor")" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
    @switch (Shape % 5)
    {
        case 1: <polygon points="0,-6 -6,5 6,5" /> break;
        case 2: <rect x="-4.5" y="-4.5" width="9" height="9" /> break;
        case 3: <polygon points="0,-6 -5,0 0,6 5,0" /> break;
        case 4: <polygon points="0,-7 2,-2.2 6.7,-2.2 3.2,1.2 4.2,6 -0,3.5 -4.2,6 -3.2,1.2 -6.7,-2.2 -2,-2.2" /> break;
        default: <circle r="4.8" /> break;
    }
</g>

@code {
    [Parameter] public int Shape { get; set; }
}
