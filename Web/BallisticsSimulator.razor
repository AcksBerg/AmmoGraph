@implements IDisposable
@inject Microsoft.Extensions.Logging.ILogger<BallisticsSimulator> Logger
<section class="ag-simulator" aria-label="@Text["SimTitle"]" data-simulator data-caliber="@CaliberId" data-running="@Running.ToString().ToLowerInvariant()" data-completed="@Completed">
    <div class="ag-sim-heading"><div><h1>@Text["SimTitle"]</h1><p>@Text["SimModel"]</p></div><span class="ag-count">@Draft.Magazine.Capacity @Text["SimRounds"]</span></div>
    <details class="ag-sim-assumptions"><summary>@Text["SimModelDetails"]</summary><p>@Text["SimAssumptions"]</p></details>
    <fieldset class="ag-sim-configuration">
        <legend class="ag-sr-only">@Text["SimConfiguration"]</legend>
        <section class="ag-magazine-editor" aria-describedby="@(RecipeError is null ? null : "ag-magazine-error")">
            <h2>@Text["SimMagazine"]</h2>
            @if (RecipeError is { } recipeError) { <p id="ag-magazine-error" class="ag-error ag-sim-error" role="alert">@Text[recipeError]</p> }
            @if (Error is not null && !ArmorError && ErrorKey != RecipeError) { <p class="ag-error ag-sim-error" role="alert">@Error</p> }
            <label class="ag-magazine-capacity">@Text["SimMagazineSize"]<input data-magazine-capacity type="number" min="1" max="100" step="1" @bind:get="Draft.Magazine.Capacity" @bind:set="SetCapacity" /></label>
            @if (HasPellets)
            {
                <label class="ag-magazine-capacity">@Text["SimPelletHitRate"]<input data-pellet-hit-rate type="number" min="0" max="100" step="0.1" @bind:get="Draft.PelletHitPercent" @bind:set="SetPelletHitPercent" /></label>
                <p class="ag-sim-hint">@Text["SimPelletHitHint"]</p>
            }
            <MagazineBlockEditor Block="Draft.Magazine.Start" Capacity="Draft.Magazine.Capacity" Optional="true" Title="@Text["SimStart"]" Ammo="Ammo" Text="Text" OnAmmoHover="OnAmmoHover" OnChange="v => SetRecipe(Draft.Magazine with { Start = v })" />
            <div class="ag-middle-heading"><h3>@Text["SimMiddle"]</h3><button type="button" data-add-middle disabled="@(Ammo.Length == 0 || Draft.Magazine.Middle.Length >= 100)" @onclick="AddMiddle">+ @Text["SimAddGroup"]</button></div>
            @for (var i = 0; i < Draft.Magazine.Middle.Length; i++)
            {
                var index = i;
                <div class="ag-middle-row" data-middle-index="@index">
                    <MagazineBlockEditor Block="Draft.Magazine.Middle[index]" Inline="true" Title="@((index + 1) + ".")" Ammo="Ammo" Text="Text" OnAmmoHover="OnAmmoHover" OnChange="v => SetMiddle(index, v)" />
                    <div class="ag-order-controls"><button type="button" disabled="@(index == 0)" aria-label="@Text["SimMoveUp"]" @onclick="() => Move(index, -1)">↑</button><button type="button" disabled="@(index == Draft.Magazine.Middle.Length - 1)" aria-label="@Text["SimMoveDown"]" @onclick="() => Move(index, 1)">↓</button><button type="button" aria-label="@Text["SimRemove"]" @onclick="() => SetMiddle(index, null)">×</button></div>
                </div>
            }
            @if (Draft.Magazine.Middle.Length == 0) { <p class="ag-sim-hint">@Text["SimMiddleHint"]</p> }
            <MagazineBlockEditor Block="Draft.Magazine.End" Capacity="Draft.Magazine.Capacity" Optional="true" Title="@Text["SimEnd"]" Ammo="Ammo" Text="Text" OnAmmoHover="OnAmmoHover" OnChange="v => SetRecipe(Draft.Magazine with { End = v })" />
        </section>
        <section class="ag-armor-editor">
            <h2>@Text["SimArmor"]</h2>
            <label>@Text["SimArmorSearch"]<input class="ag-input" type="search" maxlength="128" @bind="ArmorSearch" @bind:event="oninput" /></label>
            <label>@Text["SimArmor"]<select @key="(Language, ArmorSearch)" data-armor value="@(Draft.ArmorId ?? "")" @onchange="ArmorChanged">
                <option value="">@Text["SimUnarmored"]</option>
                @foreach (var armor in Catalog.Carriers.Values.Where(a => a.Id == Draft.ArmorId || AmmoSearch.Matches(ArmorSearch, Catalog.Name(a.Id, Language))).OrderBy(a => Catalog.Name(a.Id, Language), StringComparer.CurrentCultureIgnoreCase))
                { <option value="@armor.Id">@Catalog.Name(armor.Id, Language)@(armor.OnlyFixedInsert ? " (" + Text["SimOnlyFixedInsert"] + ")" : "")</option> }
            </select></label>
            <ArmorFilters Parts="AvailableProtection" Classes="FilterClasses" Materials="FilterMaterials" Text="Text" MaterialName="MaterialName" OnChanged="FiltersChanged" />
            <label>@Text["SimZone"]<select data-zone value="@Draft.Zone" @onchange="ZoneChanged">
                @foreach (var zone in Enum.GetValues<HitZone>()) { <option value="@zone">@Text["SimZone" + zone]</option> }
            </select></label>
            <label class="ag-sim-show-slots"><input type="checkbox" @bind="ShowAllSlots" />@Text["SimAllSlots"]</label>
            @if (Carrier is { } carrier)
            {
                @if (carrier.OwnPart is { } own) { <p>@Catalog.Name(own, Language) · @PartDescription(own)</p> }
                @foreach (var slot in carrier.Slots.Where(s => ShowAllSlots || SlotInZone(s)))
                {
                    var chosen = slot.Locked ? slot.DefaultPart : Draft.Slots.GetValueOrDefault(slot.Id, slot.DefaultPart);
                    <div class="ag-armor-slot" data-slot="@slot.Id" data-locked="@slot.Locked.ToString().ToLowerInvariant()">
                        @if (slot.Locked)
                        {
                            <span>@Catalog.Label(slot.Id, Language) <small>@Text["SimFixedInsert"]</small></span>
                            <p>@(chosen is null ? Text["SimRequiredInsert"] : Catalog.Name(chosen, Language))</p>
                        }
                        else
                        {
                            <label><span>@Catalog.Label(slot.Id, Language)</span>
                                <select @key="(slot.Id, FilterKey, Language)" value="@(chosen ?? "")" @onchange="e => SlotChanged(slot.Id, e.Value?.ToString())">
                                    @if (!slot.Required) { <option value="">@Text["SimEmptySlot"]</option> }
                                    @foreach (var id in slot.AllowedParts.Where(id => id == chosen || PartMatches(Catalog.Parts[id])).OrderBy(id => Catalog.Name(id, Language), StringComparer.CurrentCultureIgnoreCase))
                                    { <option value="@id">@Catalog.Name(id, Language) | @PartDescription(id)</option> }
                                </select>
                            </label>
                        }
                        @if (chosen is not null) { <small>@PartDescription(chosen)</small> }
                    </div>
                }
            }
            @if (Error is not null && ArmorError) { <p class="ag-error ag-sim-error" role="alert">@Error</p> }
        </section>
    </fieldset>
    <details class="ag-magazine-preview" aria-label="@Text["SimPreview"]">
        <summary>@Text["SimPreview"]</summary>
        @if (Preview is { } preview)
        {
            <ol>@for (var i = 0; i < preview.Length; i++) { var index = i; <li class="ag-ammo-tooltip-target" data-id="@preview[index]" tabindex="0" @onmouseenter="() => OnAmmoHover.InvokeAsync(preview[index])" @onfocus="() => OnAmmoHover.InvokeAsync(preview[index])"><small>@(index + 1)</small><span>@AmmoName(preview[index])</span></li> }</ol>
        }
        else { <p class="ag-sim-hint">@Text["SimInvalidMagazine"]</p> }
    </details>
    <div class="ag-sim-actions" aria-live="polite">
        <span>@Text["SimAutomatic"]</span>
        @if (Running) { <progress max="100" value="@Progress" aria-label="@Text["SimProgress"]"></progress><span role="status">@Progress %</span> }
        @if (Preview is null) { <span>@Text["SimInvalidMagazine"]</span> }
    </div>

    @if (Result is { } result)
    {
        @if (IsStale) { <p class="ag-sim-stale" role="status">@Text["SimStale"]</p> }
        <SimulationChart Result="result" Catalog="Catalog" Ammo="Ammo" Text="Text" Language="@Language" ShowAmmoNames="ShowAmmoNames" OnToggleAmmoNames="OnToggleAmmoNames" />
    }
</section>
@code {
    [Parameter, EditorRequired] public SimulationCatalog Catalog { get; set; } = null!;
    [Parameter, EditorRequired] public SimulatorWorkspace Workspace { get; set; } = null!;
    [Parameter] public string CaliberId { get; set; } = "";
    [Parameter] public AmmoEntry[] Ammo { get; set; } = [];
    [Parameter] public UiText Text { get; set; } = null!;
    [Parameter] public string Language { get; set; } = "en";
    [Parameter] public bool ShowAmmoNames { get; set; } = true;
    [Parameter] public EventCallback OnToggleAmmoNames { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<string> OnAmmoHover { get; set; }
    private SimulatorDraft Draft => Workspace.Get(CaliberId);
    private bool HasPellets => Ammo.Any(a => Catalog.Ammo.TryGetValue(a.TemplateId, out var ammo) && ammo.Projectiles > 1);
    private bool RecipeAllowed => Preview is { } sequence && sequence.All(id => Ammo.Any(a => a.TemplateId == id));
    private SimulationResult? Result => RecipeAllowed ? Workspace.Results.GetValueOrDefault(CaliberId) : null;
    private ArmorCarrier? Carrier => Draft.ArmorId is { } id ? Catalog.Carriers.GetValueOrDefault(id) : null;
    private string ArmorSearch = "";
    private readonly HashSet<int> FilterClasses = [];
    private readonly HashSet<string> FilterMaterials = [];
    private string FilterKey => string.Join(",", FilterClasses.Order()) + "|" + string.Join(",", FilterMaterials.Order());
    private bool PartMatches(ArmorPart p) => FilterClasses.Contains(p.Class) && FilterMaterials.Contains(p.Material);
    private ArmorPart[] AvailableProtection => Catalog.Carriers.Values.SelectMany(c => c.Slots.SelectMany(s => s.AllowedParts).Concat(c.OwnPart is { } own ? new[] { own } : Array.Empty<string>())).Distinct().Select(id => Catalog.Parts[id]).ToArray();
    protected override void OnInitialized() { FilterClasses.UnionWith(Enumerable.Range(1, AvailableProtection.Select(p => p.Class).DefaultIfEmpty(0).Max())); FilterMaterials.UnionWith(AvailableProtection.Select(p => p.Material)); }
    private string? _allowedSignature;
    protected override void OnParametersSet()
    {
        var signature = string.Join("|", Ammo.Select(a => a.TemplateId).Order());
        if (_allowedSignature is not null && _allowedSignature != signature) Schedule();
        _allowedSignature = signature;
    }
    private void FiltersChanged() { }
    private CancellationTokenSource? _debounce;
    private Task _pending = Task.CompletedTask;
    protected override Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender && Preview is not null && IsStaleOrMissing) Schedule(); return Task.CompletedTask; }
    private bool IsStaleOrMissing => Result is null || IsStale;
    private void Schedule()
    {
        Cancel(); _debounce?.Cancel();
        var source = new CancellationTokenSource(); _debounce = source;
        var previous = _pending;
        _pending = Recalculate(previous, source);
    }
    private async Task Recalculate(Task previous, CancellationTokenSource source)
    {
        try
        {
            await Task.Delay(300, source.Token);
            await previous;
            source.Token.ThrowIfCancellationRequested();
            if (!_disposed && Preview is not null) await InvokeAsync(async () => { await Run(source.Token); if (!_disposed) StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Logger.LogError(ex, "Automatic simulation failed"); }
        finally { if (ReferenceEquals(_debounce, source)) _debounce = null; source.Dispose(); }
    }
    private bool ShowAllSlots;
    private bool SlotInZone(ArmorSlot slot) => slot.PlateColliders.Any(p => SimulationCatalog.PlateInZone(p, Draft.Zone))
        || slot.BodyColliders.Any(SimulationCatalog.ZoneBodies(Draft.Zone).Contains);
    private bool Running, _disposed;
    private int Progress, Completed;
    private readonly Dictionary<string, (string Key, string? Detail)> Errors = [];
    private string? ErrorKey => Errors.TryGetValue(CaliberId, out var error) ? error.Key : null;
    private string? ErrorDetail => Errors.TryGetValue(CaliberId, out var error) ? error.Detail : null;
    private bool ArmorError => ErrorKey is "SimMissingArmor" or "SimMissingArmorData" or "SimRequiredInsert" or "SimIncompatiblePlate" or "SimUnsupportedCollider";
    private string? RecipeError { get { try { var sequence = Draft.Magazine.Expand(); return sequence.All(id => Ammo.Any(a => a.TemplateId == id)) ? null : "SimExcludedAmmo"; } catch (SimulationException ex) { return ex.Key; } } }
    private string? Error => ErrorKey is null ? null : Text[ErrorKey] + (ErrorDetail is null ? "" : " · " + ErrorDetail);
    private CancellationTokenSource? _cancellation;
    private string[]? Preview { get { try { return Draft.Magazine.Expand(); } catch (SimulationException) { return null; } } }
    private static string Fingerprint(SimulatorDraft draft) => System.Text.Json.JsonSerializer.Serialize(draft);
    private bool IsStale => Result is { } result && Fingerprint(Draft) != Fingerprint(result.Draft);
    private string AmmoName(string id) => Ammo.FirstOrDefault(a => a.TemplateId == id)?.Name ?? id;
    private string MaterialName(string material) => Catalog.Material(material, Language);
    private string PartDescription(string id) => Catalog.Parts.TryGetValue(id, out var p)
        ? $"{Text["SimClass"]} {p.Class} · {MaterialName(p.Material)} · {p.Maximum.ToString("0.#", Text.Culture)} / {p.Maximum.ToString("0.#", Text.Culture)}" : Text["SimMissingArmor"];
    private async Task Change(SimulatorDraft draft)
    {
        Cancel(); Workspace.Update(draft);
        await OnChanged.InvokeAsync();
        Schedule();
    }
    private Task SetRecipe(MagazineRecipe recipe) => Change(Draft with { Magazine = recipe });
    private Task SetCapacity(int count)
    {
        count = Math.Clamp(count, 1, 100);
        return SetRecipe(Draft.Magazine.WithCapacity(count));
    }
    private Task SetPelletHitPercent(double percent) => double.IsFinite(percent)
        ? Change(Draft with { PelletHitPercent = Math.Clamp(percent, 0, 100) }) : Task.CompletedTask;
    private Task AddMiddle() => Ammo.Length > 0 ? SetRecipe(Draft.Magazine with { Middle = [..Draft.Magazine.Middle, new(Ammo[0].TemplateId, 1)] }) : Task.CompletedTask;
    private Task SetMiddle(int index, AmmoBlock? block) => SetRecipe(Draft.Magazine with { Middle = Draft.Magazine.Middle.Where((_, i) => i != index || block is not null).Select((b, i) => i == index && block is not null ? block : b).ToArray() });
    private Task Move(int index, int direction)
    {
        var blocks = Draft.Magazine.Middle.ToArray(); var other = index + direction;
        if (other < 0 || other >= blocks.Length) return Task.CompletedTask;
        (blocks[index], blocks[other]) = (blocks[other], blocks[index]); return SetRecipe(Draft.Magazine with { Middle = blocks });
    }
    public bool ContainsAmmo(string id) => Draft.Magazine.Start?.TemplateId == id || Draft.Magazine.End?.TemplateId == id || Draft.Magazine.Middle.Any(b => b.TemplateId == id);
    public Task RemoveAmmo(string id) => SetRecipe(Draft.Magazine with {
        Start = Draft.Magazine.Start?.TemplateId == id ? null : Draft.Magazine.Start,
        End = Draft.Magazine.End?.TemplateId == id ? null : Draft.Magazine.End,
        Middle = Draft.Magazine.Middle.Where(b => b.TemplateId != id).ToArray()
    });
    public Task AddAmmo(string id, string section)
    {
        if (!Ammo.Any(a => a.TemplateId == id)) return Task.CompletedTask;
        var recipe = Draft.Magazine;
        return SetRecipe(section switch
        {
            "start" => recipe with { Start = new(id, recipe.Start?.Count ?? 1) },
            "end" => recipe with { End = new(id, recipe.End?.Count ?? 1) },
            _ => recipe.Middle.Length < 100 ? recipe with { Middle = [..recipe.Middle, new(id, 1)] } : recipe
        });
    }
    private Task ArmorChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        return Change(Draft with { ArmorId = string.IsNullOrEmpty(id) ? null : id, Slots = new() });
    }
    private Task SlotChanged(string id, string? value) => Change(Draft with { Slots = new(Draft.Slots) { [id] = string.IsNullOrEmpty(value) ? null : value } });
    private Task ZoneChanged(ChangeEventArgs e) => Enum.TryParse<HitZone>(e.Value?.ToString(), out var zone) ? Change(Draft with { Zone = zone }) : Task.CompletedTask;
    private void Cancel() => _cancellation?.Cancel();
    private async Task Run(CancellationToken token)
    {
        if (Running) return;
        if (!RecipeAllowed) { Errors[CaliberId] = ("SimExcludedAmmo", null); return; }
        Running = true; Progress = 0; StateHasChanged();
        var draft = Draft with { Magazine = Draft.Magazine with { Middle = Draft.Magazine.Middle.ToArray() }, Slots = new(Draft.Slots) };
        var key = CaliberId;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(token); _cancellation = cancellation;
        var progress = new Progress<int>(value => { if (!_disposed) _ = InvokeAsync(() => { if (!_disposed) { Progress = value; StateHasChanged(); } }); });
        try
        {
            var result = await Task.Run(() => BallisticsEngine.Run(Catalog, new(draft), progress, cancellation.Token));
            if (!_disposed && !cancellation.IsCancellationRequested && Fingerprint(Draft) == Fingerprint(draft)) { Workspace.Results[key] = result; Completed++; Errors.Remove(key); }
        }
        catch (OperationCanceledException) { }
        catch (SimulationException ex) { if (!_disposed) { Errors[key] = (ex.Key, ex.Message != ex.Key ? ex.Message : null); } }
        catch (Exception ex) { Logger.LogError(ex, "AmmoGraph simulation failed"); if (!_disposed) Errors[key] = ("SimFailed", null); }
        finally { Running = false; _cancellation = null; }
    }
    public void Dispose() { _disposed = true; Cancel(); _debounce?.Cancel(); }
}
